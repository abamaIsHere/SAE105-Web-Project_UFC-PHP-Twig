												{% if title in ['Accueil', 'Home', 'Contact', 'Contact', 'a propos', 'about'] %}
													<ul class="Combatant_articles_menu">
														{% for menu_items3 in drop_down_menu_match|sort ((a, b) => a <=> b) %}
															<li>
																<a href="match.php#{{ menu_items3|replace({' ': '_'}) }}">{{ menu_items3 }}</a>
															</li>
														{% endfor %}
													</ul>
													{% else %}

												{% endif %}

											{% endblock %}
										</li>
										<li>
											<a href="match-en.php">Past Matches</a>
