															{# main body #}

				{% block main %}
					<main>
						{% if lang == 'en' %}
							<section class="field_1">
															{# home opening post #}
								<div class="banner-section">
									<div class="sec_img">
										<img src="images/home/ZB1-Walsh-Ocampo-Faceoff-small.avif" alt="Walsh Ocampo Faceoff image">
									</div>
									<div class="ban_sec_info">
										<p class="sec_ban_txt">Prelims 6pm ET | Main Card 9pm ET</p>
										<h2 class="sec_title">Zuffa Boxing 01</h2>
										<p class="sub_line">Callum Walsh vs. Carlos Ocampo headlines first event tonight</p>
										<div class="buttons">
											<a class="button1" target="_blank" href="">preview map</a>
											<a class="button2" target="_blank" href="">more Zuffa boxing</a>
										</div>
									</div>
								</div>
								<aside class="top_side">
									<div class="story_list">
										<h2>Main news</h2>
										<ol class="story_items">
										
											{% for story in top_stories %}
												<li class="story_lists">
													<div class="story_list_item">
														<p>{{ story.aside_item_type }}</p>
														<a href="">
															{{ story.aside_item_desc }}</a>
													</div>
												</li>
											{% endfor %}

										</ol>
									</div>
								</aside>
							</section>
						{% else %}
															{# home opening post french #}															{# main body content french#}
							<section class="field_1">
								<div class="banner-section">
									<div class="sec_img">
										<img src="images/home/ZB1-Walsh-Ocampo-Faceoff-small.avif" alt="Walsh-Ocampo-Faceoff">
									</div>
									<div class="ban_sec_info">
										<p class="sec_ban_txt">Prelims 6pm ET | Main Card 9pm ET</p>
										<h2 class="sec_title">Zuffa Boxing 01</h2>
										<p class="sub_line">Callum Walsh contre Carlos Ocampo en tête d'affiche du premier événement ce soir</p>
										<div class="buttons">
											<a class="button1" target="_blank" href="">prévisualiser la carte</a>
											<a class="button2" target="_blank" href="">plus de boxe Zuffa</a>
										</div>
									</div>
								</div>
								<aside class="top_side">
									<div class="story_list">
										<h2>Actualités principales</h2>
										<ol class="story_items">
											{% for story in top_stories %}

												<li class="story_lists">
													<div class="story_list_item">
														<p>{{ story.aside_item_type }}</p>
														<a href="">
															{{ story.aside_item_desc }}</a>
													</div>
												</li>

											{% endfor %}
										</ol>
									</div>
								</aside>
							</section>
						{% endif %}

						<section class="field_2">
															{# next fight schedule #}
							<div class="player_1">
								<div class="role_backbround">
									<figure class="hero_img">
										<img src="./images/home/BAUTISTA_MARIO_L_02-07.avif" alt="BAUTISTA MARIO">
										<figcaption>Bautista Mario</figcaption>
									</figure>
								</div>
							</div>

							<div class="field_2_details">
								<img src="./images/fond/UFC_Logo.webp" alt="ufc background logo">
								{% if lang == 'en' %}
									<p>Next UFC Fight Night</p>
								{% else %}
									<p>Suivant UFC Fight Night</p>
								{% endif %}

								<h2>Bautista vs Oliveira</h2>
							</div>

							<div class="player_2">
								<div class="role_backbround">
									<figure class="hero_img">
										<img src="./images/home/OLIVEIRA_VINICIUS_R_02-07.avif" alt="OLIVEIRA VINICIUS">
										<figcaption>Bautista Mario</figcaption>
									</figure>
								</div>
							</div>
						</section>

						<section class="home_articls">
															{# home articles #}
							{% if lang == 'en' %}
								<h2>Featured Content</h2>
							{% else %}
								<h2>Contenu en vedette</h2>
							{% endif %}
							{% for home_small_article in home_short_article %}
								<article>
									<div class="home_small_article_img">
										<img src="{{ home_small_article.h_a_img}}" alt="{{ home_small_article.h_a_title }}">
									</div>
									<div class="home_small_article_detail">
										<span>{{ home_small_article.h_a_tag }}</span>
										<h2>{{ home_small_article.h_a_title }}</h2>
										<p>{{ home_small_article.h_a_desc }}</p>
									</div>
								</article>
							{% endfor %}
						</section>

						<section class="slide_bar">
															{# slide bar section #}
							{% if lang == 'en' %}
								<h2>comments from fighters</h2>
							{% else %}
								<h2>commentaires des combattants</h2>
							{% endif %}

							<div class="carousel">
								<div class="content_group">
									{% for slide_section in home_slide_bar %}
										<div class="group_cards">
											<div class="content_cards_img"><img src="{{ slide_section.img }}" alt="{{ slide_section.name }}"></div>
											<blockquote>
												{{ slide_section.title }}
												<cite>{{ slide_section.name }}</cite>
											</blockquote>
										</div>
									{% endfor %}
								</div>
								<div aria-hidden class="content_group">
									{% for slide_section in home_slide_bar %}
										<div class="group_cards">
											<div class="content_cards_img"><img src="{{ slide_section.img }}" alt="{{ slide_section.name }}"></div>
											<blockquote>
												{{ slide_section.title }}
												<cite>{{ slide_section.name }}</cite>
											</blockquote>
										</div>
									{% endfor %}
								</div>
							</div>
						</section>
