												{% if title in ['Accueil', 'Home', 'Contact', 'Contact', 'a propos', 'about'] %}
													<ul class="Combatant_articles_menu">
														{% for menu_items2 in drop_down_menu_actu %}
															<li>
																<a href="actu.php#{{ menu_items2|replace({' ': '_'}) }}">{{ menu_items2 }}</a>
															</li>
														{% endfor %}
													</ul>
													{% else %}

												{% endif %}

											{% endblock %}
										</li>
										{% block language %}
											<li>
												<a href="index.php"><img src="./images/language_icon/united-kingdom.png" alt="language icon for united-kingdom"></a>
											</li>
										{% endblock %}
									</ul>
								</nav>
							</div>
						</div>
															{# header french #}
					{% else %}
						<div class="header_content">
							<div class="menu_main">
								<nav class="main_menu">
									<ul>
										<li><a href="index.php">Accueil</a></li>
										<li><a href="a_propos.php">A propos</a></li>
										<li><a href="contact.php">Contact</a></li>
									</ul>
								</nav>
							</div>
							<div class="logo">
								<a href="index.php">
									<img src="./images/5cf6f44351dc7d3d260a674e_BG_Logo.png" alt="logo ufc">
								</a>
							</div>
							<div class="menu_category">
								<nav class="main_menu">
									<ul>
										<li>
											<a href="fighters.php">Combatant</a>
