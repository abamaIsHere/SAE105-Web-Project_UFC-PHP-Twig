												{% if title in ['Accueil', 'Home', 'Contact', 'Contact', 'a propos', 'about'] %}
													<ul class="Combatant_articles_menu">
														{% for menu_items in drop_down_menu_fighters %}
															<li>
																<a href="fighters.php#{{ menu_items|replace({' ': '_'}) }}">{{ menu_items }}</a>
															</li>
														{% endfor %}
													</ul>
													{% else %}

												{% endif %}
											{% endblock %}
										</li>
										<li>
											<a href="actu-en.php">News</a>
